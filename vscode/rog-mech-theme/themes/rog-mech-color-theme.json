  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#6b7380", "fontStyle": "italic" }
    },
    {
      "name": "Keywords / storage",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.other.using", "keyword.other.import"],
      "settings": { "foreground": "#ff5566" }
    },
    {
      "name": "Function / return keywords",
      "scope": ["storage.type.function", "keyword.control.flow", "keyword.control.return", "keyword.function", "keyword.control.import", "keyword.control.export", "keyword.control.from"],
      "settings": { "foreground": "#e57b98" }
    },
    {
      "name": "Operators / punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#8794a6" }
    },
    {
      "name": "Word operators",
      "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.wordlike"],
      "settings": { "foreground": "#ff5566" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "meta.function-call", "support.function", "variable.function", "entity.name.method"],
      "settings": { "foreground": "#b8d4ff" }
    },
    {
      "name": "Types / classes",
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive", "entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#6f93c4" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"],
      "settings": { "foreground": "#7fc29b" }
    },
    {
      "name": "String escapes / regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
      "settings": { "foreground": "#7fb4c9" }
    },
    {
      "name": "Template interpolation",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#ff2233" }
    },
    {
      "name": "Numbers / constants",
      "scope": ["constant", "constant.numeric", "constant.language", "support.constant", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#e8a24a" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#f3c27f" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#d6dde6" }
    },
    {
      "name": "this / self",
      "scope": ["variable.language", "variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#ff2233", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "entity.name.tag.yaml", "support.type.property-name"],
      "settings": { "foreground": "#a9b6c6" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#ff2233" }
    },
    {
      "name": "Components (JSX)",
      "scope": ["support.class.component", "entity.name.tag.component"],
      "settings": { "foreground": "#6f93c4" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#e8a24a", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": { "foreground": "#ff5566" }
    },
    {
      "name": "Decorators / annotations",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation"],
      "settings": { "foreground": "#7fb4c9" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff2233", "fontStyle": "underline" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#ff2233", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold / italic",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#eef2f6", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#d6dde6", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#b8d4ff" }
    },
    {
      "name": "Markdown quotes / lists",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#8794a6" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#7fc29b" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff2233" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#6f93c4" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6f93c4",
    "class": "#6f93c4",
    "interface": "#6f93c4",
    "enum": "#6f93c4",
    "type": "#6f93c4",
    "typeParameter": "#6f93c4",
    "function": "#b8d4ff",
    "method": "#b8d4ff",
    "parameter": "#f3c27f",
    "property": "#a9b6c6",
    "enumMember": "#e8a24a",
    "variable.defaultLibrary": "#7fb4c9",
    "decorator": "#7fb4c9",
    "keyword": "#ff5566"
  }
}
