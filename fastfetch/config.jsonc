{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // ROG Mech: $1 = ROG red, $2 = chrome (see logo.txt)
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": { "top": 1, "right": 4 },
        "color": {
            "1": "38;2;255;34;51",
            "2": "38;2;169;182;198"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;255;34;51",
            "title": "1;38;2;238;242;246",
            "output": "38;2;214;221;230",
            "separator": "38;2;85;92;104"
        },
        "percent": { "type": 9 },
        "bar": { "charElapsed": "█", "charTotal": "░", "borderLeft": "[", "borderRight": "]" }
    },
    "modules": [
        {
            "type": "title",
            "color": { "user": "1;38;2;255;34;51", "at": "38;2;85;92;104", "host": "1;38;2;238;242;246" }
        },
        { "type": "separator", "string": "━", "outputColor": "38;2;107;10;18" },
        { "type": "os",       "key": " ", "format": "{3} (Btw)" },
        { "type": "kernel",   "key": " " },
        { "type": "wm",       "key": " " },
        { "type": "shell",    "key": " " },
        { "type": "terminal", "key": " " },
        { "type": "uptime",   "key": " " },
        { "type": "separator", "string": "━", "outputColor": "38;2;34;43;54" },
        { "type": "host",     "key": "󰇅 ", "keyColor": "38;2;184;212;255" },
        { "type": "cpu",      "key": " ", "keyColor": "38;2;184;212;255" },
        { "type": "gpu",      "key": "󰢮 ", "keyColor": "38;2;184;212;255" },
        { "type": "memory",   "key": " ", "keyColor": "38;2;184;212;255" },
        { "type": "disk",     "key": "󰋊 ({mountpoint})", "keyColor": "38;2;184;212;255", "folders": "/:/home:/srv:/opt:/var" },
        "break",
        { "type": "colors", "symbol": "block" }
    ]
}
