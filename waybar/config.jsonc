// ROG Mech — icon tints use the palette in colors.css:
//   red #ff2233   steel #8794a6   overlay #555c68   volt #b8d4ff
{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "group/distro", "custom/kernel", "custom/cava"],
    "modules-center": ["group/time"],
    "modules-right": [
        "temperature", "cpu", "memory", "custom/vram", "disk",
        "wireplumber", "bluetooth", "network", "custom/netspeed",
        "custom/uptime", "battery"
    ],

    "group/distro": {
        "orientation": "horizontal",
        "modules": ["image#rog", "custom/distro", "image#trixie"]
    },

    "image#rog": {
        "exec": "echo ~/.config/waybar/rog.svg",
        "size": 17,
        "tooltip": false
    },

    "image#trixie": {
        "exec": "echo ~/.config/waybar/trixie.png",
        "size": 15,
        "tooltip": false
    },

    "custom/distro": {
        "format": "<span color='#555c68'>| </span> XIII",
        "tooltip": false
    },

    "custom/kernel": {
        "exec": "uname -r",
        "interval": "once",
        "format": "<span color='#ff2233'></span> {}",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "󰍹 {id}",
        "on-click": "activate"
    },

    "custom/cava": {
        "exec": "exec ~/.config/waybar/scripts/cava.sh",
        "tooltip": false
    },

    "group/time": {
        "orientation": "horizontal",
        "modules": ["custom/clockformat", "custom/clock", "custom/weather"]
    },

    "custom/clockformat": {
        "exec": "~/.config/waybar/scripts/clock-format.sh",
        "on-click": "~/.config/waybar/scripts/clock-format.sh toggle",
        "return-type": "json",
        "tooltip": true
    },
    "custom/clock": {
        "exec": "exec ~/.config/waybar/scripts/clock.py",
        "on-click": "~/.config/waybar/scripts/calendar-popup.py",
        "return-type": "json",
        "tooltip": true
    },

    "custom/weather": {
        "on-click": "~/.config/waybar/scripts/calendar-popup.py",
        "exec": "exec ~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "format": "<span color='#555c68'> | </span><span color='#8794a6'>󰔏</span> {}"
    },

    "temperature": {
        "format": "<span color='#ff2233'></span>  {temperatureC}°C",
        "format-critical": "  {temperatureC}°C",
        "warning-threshold": 50,
        "critical-threshold": 80,
        "tooltip": true
    },

    "cpu": {
        "states": { "low": 0, "medium": 40, "high": 75 },
        "format": "<span color='#ff2233'></span>  {usage}%",
        "tooltip": true
    },

    "memory": {
        "states": { "low": 0, "medium": 50, "high": 80 },
        "format": "<span color='#ff2233'></span>  {percentage}%",
        "tooltip": true
    },

    "custom/vram": {
        "exec": "~/.config/waybar/scripts/vram.sh",
        "return-type": "json",
        "interval": 5,
        "states": { "low": 0, "medium": 50, "high": 80 },
        "format": "<span color='#ff2233'>󰢮</span> {}",
        "tooltip": true
    },

    "disk": {
        "states": { "low": 0, "medium": 60, "high": 85 },
        "format": "<span color='#ff2233'>󰋊</span> {percentage_used}%",
        "path": "/"
    },

    "wireplumber": {
        "states": { "low": 0, "medium": 40, "high": 75 },
        "format": "<span color='#ff2233'>󰕾</span> {volume}%",
        "format-muted": "󰝟 ",
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format-on": "<span color='#ff2233'>󰂯</span> on",
        "format-off": "󰂲 off",
        "format-disabled": "󰂲",
        "format-connected": "<span color='#ff2233'></span> {device_alias}",
        "format-connected-battery": "<span color='#ff2233'></span> {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "<span color='#ff2233'>󰤨</span> ",
        "format-ethernet": "<span color='#ff2233'>󰈀</span> ",
        "format-disconnected": "󰤭 "
    },

    "custom/netspeed": {
        "exec": "~/.config/waybar/scripts/netspeed.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },

    "custom/uptime": {
        "exec": "~/.config/waybar/scripts/uptime.sh",
        "return-type": "json",
        "interval": 60,
        "tooltip": true
    },

    "battery": {
        "format": "<span color='#ff2233'>{icon}</span> {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": { "warning": 25, "critical": 10 }
    }
}
