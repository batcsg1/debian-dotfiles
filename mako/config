# ROG Mech — gunmetal panel, red edge (see README.md)
font=JetBrainsMono Nerd Font 10
background-color=#0b1015e6
text-color=#d6dde6
border-color=#ff2233
progress-color=over #3a0d15
border-size=2
border-radius=0
padding=10
margin=10
width=350
default-timeout=5000
# the Waybar bell lists these; mako keeps 5 by default
max-history=30

[urgency=low]
border-color=#555c68

[urgency=normal]
border-color=#ff2233

[urgency=critical]
border-color=#b8d4ff
background-color=#24090ee6
default-timeout=0

# toggled by right-clicking the Waybar bell
[mode=do-not-disturb]
invisible=1
